{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/policy-inheritance.schema.json",
  "title": "Person / Resource Policy Inheritance and Override Set",
  "description": "Deterministic composition rules for base policies, person/resource-specific policies and channel overrides. Restriction is automatic; widening requires explicit grant authority.",
  "type": "object",
  "required": [
    "schema",
    "policy_schema",
    "selector_schema",
    "defaults",
    "resolution",
    "base_policies",
    "person_policies",
    "resource_policies",
    "channel_overrides"
  ],
  "properties": {
    "schema": {
      "const": "policy-inheritance/v0.1"
    },
    "policy_schema": {
      "const": "/person-resource-policy.schema.json"
    },
    "defaults": {
      "type": "object",
      "required": [
        "missing_gate",
        "unknown_subject",
        "missing_policy",
        "expired_policy"
      ],
      "properties": {
        "missing_gate": {
          "const": "deny"
        },
        "unknown_subject": {
          "type": "string",
          "enum": [
            "deny",
            "review"
          ]
        },
        "missing_policy": {
          "type": "string",
          "enum": [
            "deny",
            "review"
          ]
        },
        "expired_policy": {
          "type": "string",
          "enum": [
            "deny",
            "review"
          ]
        }
      },
      "additionalProperties": false
    },
    "resolution": {
      "type": "object",
      "required": [
        "stages",
        "same_stage_conflict",
        "restrict_vs_grant",
        "grant_rule",
        "locked_rule",
        "cycle_rule",
        "trace_required",
        "selector_match_rule",
        "selector_precedence_rule",
        "fallback_rule",
        "grant_specificity_rule"
      ],
      "properties": {
        "stages": {
          "type": "array",
          "prefixItems": [
            {
              "const": "base"
            },
            {
              "const": "subject_parallel"
            },
            {
              "const": "channel"
            }
          ],
          "items": false
        },
        "subject_parallel": {
          "const": "person and resource policies are evaluated independently, then intersected; neither silently outranks the other"
        },
        "same_stage_conflict": {
          "const": "deny_overrides_allow"
        },
        "restrict_vs_grant": {
          "const": "restrict_first_then_authorized_grant_then_reapply_explicit_denies_and_locks"
        },
        "grant_rule": {
          "const": "grant mode may widen inherited/default authority only when authority.source=user_explicit and authorization_ref is present"
        },
        "locked_rule": {
          "const": "a lock on a path or ancestor path cannot be widened by any descendant or later layer"
        },
        "cycle_rule": {
          "const": "reject_policy_set"
        },
        "trace_required": {
          "const": true
        },
        "selector_match_rule": {
          "const": "all matching non-fallback policies remain in the merge set; specificity never discards broader restrictions"
        },
        "selector_precedence_rule": {
          "const": "within a layer: exact > pattern > tag > fallback; more matched positive clauses breaks same-class ties; selector_id lexical order is trace-only"
        },
        "fallback_rule": {
          "const": "fallback activates only when zero non-fallback selectors match the same layer/domain branch"
        },
        "grant_specificity_rule": {
          "const": "authorized grant may widen only non-deny non-locked restrictions at lower-or-equal effective specificity; explicit deny and lock are never widened"
        }
      },
      "additionalProperties": false
    },
    "field_algebra": {
      "type": "object",
      "required": [
        "decision",
        "allow_sets",
        "deny_sets",
        "ceilings",
        "required_booleans",
        "conditions",
        "retention",
        "locks"
      ],
      "properties": {
        "decision": {
          "type": "object",
          "properties": {
            "restrict_order": {
              "type": "array",
              "prefixItems": [
                {
                  "const": "allow"
                },
                {
                  "const": "conditional"
                },
                {
                  "const": "review"
                },
                {
                  "const": "deny"
                }
              ],
              "items": false
            },
            "same_specificity": {
              "const": "choose_most_restrictive"
            },
            "explicit_deny": {
              "const": "wins_over_allow_at_same_stage_and_is_reapplied_after_grants"
            },
            "inherited_default_deny": {
              "const": "may_be_widened_only_by_authorized_grant"
            }
          },
          "required": [
            "restrict_order",
            "same_specificity",
            "explicit_deny",
            "inherited_default_deny"
          ],
          "additionalProperties": false
        },
        "allow_sets": {
          "const": "intersection"
        },
        "deny_sets": {
          "const": "union"
        },
        "ceilings": {
          "const": "minimum_or_most_restrictive"
        },
        "required_booleans": {
          "const": "logical_or_for_requirements; logical_and_for_permissions"
        },
        "conditions": {
          "const": "logical_and_across_inherited_restrictive_conditions"
        },
        "retention": {
          "const": "shortest_retention_wins; ttl_uses_minimum_seconds"
        },
        "locks": {
          "const": "union_and_ancestor_path_applies_to_descendants"
        }
      },
      "additionalProperties": false
    },
