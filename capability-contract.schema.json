{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/capability-contract.schema.json",
  "title": "Showcase Capability Contract",
  "description": "Minimal agent-readable contract for routing work into a bounded public capability.",
  "type": "object",
  "required": [
    "accepts",
    "transforms",
    "emits",
    "evidence"
  ],
  "properties": {
    "accepts": {
      "type": "object",
      "required": [
        "kinds"
      ],
      "properties": {
        "kinds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "optional": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "transforms": {
      "type": "object",
      "required": [
        "verb",
        "preserves",
        "reversibility"
      ],
      "properties": {
        "verb": {
          "type": "string"
        },
        "preserves": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reversibility": {
          "enum": [
            "none",
            "bounded",
            "full"
          ]
        },
        "side_effects": {
          "enum": [
            "none",
            "local",
            "external"
          ],
          "default": "none"
        }
      },
      "additionalProperties": false
    },
    "emits": {
      "type": "object",
      "required": [
        "kinds"
      ],
      "properties": {
        "kinds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "machine_readable": {
          "type": "boolean",
          "default": false
        },
        "human_readable": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "receipt",
        "checks"
      ],
      "properties": {
        "receipt": {
          "type": [
            "string",
            "null"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "return_path": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
