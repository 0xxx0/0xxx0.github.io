{
  "schema": "0xxx0/source-hold-turn-trace-return/v0.1",
  "updated": "2026-10-02T20:06:00+08:00",
  "status": "OPERATIONAL",
  "purpose": "Reduce a selected object to one lawful bounded move, observed consequence, durable evidence and exact re-entry without creating a new authority plane.",
  "aliases": {
    "SOURCE": "identify exact object + owner + provenance",
    "HOLD": "one stable focus + <=3 lawful moves",
    "TURN": "one selected host-native move",
    "TRACE": "observed witness, evidence, unknowns",
    "RETURN": "durable closure + exact re-entry"
  },
  "laws": [
    "One object/focus at a time unless the native host explicitly defines a composite object.",
    "HOLD is selection/focus and creates no effect authority.",
    "At most three candidate native moves may be exposed at HOLD.",
    "TURN executes exactly one bounded native move.",
    "If TURN crosses an EFFECT boundary, RELEASE/commit must be explicit and host-native.",
    "TRACE separates observed, derived and unknown claims.",
    "RETURN is required for changed, unchanged, failed, blocked and unknown outcomes.",
    "RETURN never auto-authorizes NEXT; replan from CURRENT after closure.",
    "Authority may stay equal or decrease across projection/handoff; it may not silently increase.",
    "No second move inherits authority from the first."
  ],
  "stages": [
    {
      "id": "SOURCE",
      "entry": [
        "request/observation/artifact/message/device/world fact exists",
        "candidate is worth resolving"
      ],
      "required": [
        "object_id_or_address",
        "owner",
        "provenance",
        "current_truth_source",
        "return_address"
      ],
      "exit": [
        "one exact source object named",
        "owner/provenance known",
        "action-relevant ambiguity resolved or marked UNKNOWN"
      ],
      "fail_closed": [
        "no trustworthy owner/address/provenance",
        "candidate identities imply different actions"
      ],
      "example": {
        "object": "/nexus/map.html",
        "owner": "repository/native file",
        "provenance": [
          "/nexus/map.html",
          "/control/CURRENT.json",
          "/showcase-manifest.json"
        ],
        "result": "stale system map identified from exact current files"
      }
    },
    {
      "id": "HOLD",
      "entry": [
        "SOURCE exit satisfied"
      ],
      "required": [
        "focus",
        "desired_delta",
        "moves_0_to_3",
        "authority_per_move",
        "target_per_move",
        "reversibility_per_move",
        "commit_boundary_per_move",
        "exact_return"
      ],
      "exit": [
        "one stable focus",
        "one move may be deliberately selected",
        "exact RETURN known"
      ],
      "fail_closed": [
        "scope silently expands to several objects",
        "move owner unclear",
        "requires invented authority"
      ],
      "example": {
        "focus": "/nexus/map.html",
        "desired_delta": "current truthful architecture map reachable from FIELD without enlarging primary surface",
        "moves": [
          "update map in place",
          "add latent FIELD footer link",
          "align manifest/RETURN"
        ]
      }
    },
    {
      "id": "TURN",
      "entry": [
        "HOLD exit satisfied",
        "one move selected",
        "preconditions current"
      ],
      "required": [
        "selected_move",
        "native_operation",
        "authority",
        "target",
        "commit_boundary",
        "reversibility"
      ],
      "exit": [
        "native result is CHANGED|UNCHANGED|FAILED|BLOCKED|UNKNOWN",
        "touched scope known"
      ],
      "fail_closed": [
        "precondition failed",
        "authority missing",
        "target drifted",
        "would require unbounded migration"
      ],
      "example": {
        "selected_move": "bounded repo delta",
        "native_operation": "update existing files",
        "result": "map + latent link + manifest + receipt written; no new dashboard/store"
      }
    },
    {
      "id": "TRACE",
      "entry": [
        "TURN returned or stopped"
      ],
      "required": [
        "status",
        "observed_delta",
        "touched_objects",
        "evidence_refs",
        "unknowns"
      ],
      "exit": [
        "what changed is distinguishable from what is merely inferred",
        "unproved claims remain explicit"
      ],
      "fail_closed": [
        "behavioral claim supported only by intention/prose/image/model belief"
      ],
      "example": {
        "status": "CHANGED",
        "observed_delta": "committed files resolve requested architecture and route",
        "evidence": [
          "re-fetched map",
          "root link present",
          "manifest route present",
          "receipt present"
        ],
        "unknowns": [
          "no attached CI run/live-render proof at trace time"
        ]
      }
    },
    {
      "id": "RETURN",
      "entry": [
        "TRACE exists"
      ],
      "required": [
        "result_status",
        "observed_delta",
        "evidence_refs",
        "residue",
        "unresolved_gate",
        "return_address"
      ],
      "exit": [
        "successor can resume without reconstructing intent/authority/evidence/gate",
        "focus released",
        "attention may be replanned"
      ],
      "fail_closed": [
        "closure omits evidence/unknowns",
        "rewrites source truth",
        "auto-promotes NEXT",
        "overclaims proof"
      ],
      "example": {
        "receipt": "/returns/SYSTEM_MAP_CONVERGENCE_2026-10-02.json",
        "return_address": "/",
        "residue": "architecture map 0.2 + explicit authority/convergence law"
      }
    }
  ],
  "worker_packet": {
    "source": {
      "object": null,
