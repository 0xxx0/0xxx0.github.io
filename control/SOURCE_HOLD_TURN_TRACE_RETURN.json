      "unresolved_gate": null,
      "return_to": null
    }
  },
  "worker_rules": [
    "Boot with /AGENTS.md and /llms.txt.",
    "Recover only selected-object depth.",
    "Prefer node tools/ship-check.mjs --fast plus the smallest feature-specific selftest.",
    "Do not claim CI/browser/device/human/world proof unless it actually ran.",
    "Return on failure/no-op.",
    "After RETURN re-read CURRENT before another consequential move.",
    "If no lawful high-value move exists, emit NO_LAWFUL_HIGH_VALUE_MOVE and stop."
  ],
  "related": [
    "/lib/interphase-carrier.js",
    "/control/INTERPHASE_MAPPING_CONTRACT.json",
