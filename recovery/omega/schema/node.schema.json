{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "omega://schema/node",
  "type": "object",
  "required": ["id", "type", "text", "status"],
  "properties": {
    "id": {"type": "string"},
    "type": {"enum": ["ENT","EVT","OBS","CLM","CON","DEC","ART","TST","QST","ACT"]},
    "role": {"type": ["string","null"]},
    "text": {"type": "string"},
    "status": {"type": "string"},
    "valid_from": {"type": ["string","null"]},
    "valid_to": {"type": ["string","null"]},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["span_id","evidence_root"],
        "properties": {
          "span_id": {"type": "string"},
          "evidence_root": {"type": "string"},
          "source_role": {"type": "string"}
        }
      }
    },
    "metadata": {"type": "object"}
  },
  "additionalProperties": true
}
