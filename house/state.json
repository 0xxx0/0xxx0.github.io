 "identity_rules": [
  {
   "id": "address_is_not_identity",
   "rule": "A network address is never an object identity. Objects are keyed on device id / product key / registry id, never on an IP.",
   "evidence": [
    "an address that hosted a Midea-OUI appliance in June now hosts the HAOS guest \u2014 the same address, a different object",
    "the guest's own lease moved twice within a single session while the guest kept its identity (DHCP churn is not an identity event)"
   ],
   "consequence": "all scripts address the guest by its mDNS name, never by address",
   "epistemic": "OBSERVED"
  },
  {
   "id": "cat_resource_state_is_not_cat_identity",
   "rule": "Litter-box telemetry is RESOURCE state. `cat_weight` is one observed measurement; `excretion_times_day` is a resource count. Neither identifies which cat, and neither is divided between cats.",
   "constraints": [
    "cat_identity = UNKNOWN unless independently resolved",
    "no per-cat visit/excretion attribution from weight alone",
    "individual attribution is a separate inference layer (vision/camera, phone sensors, repeated weight clustering) carrying its own confidence and provenance"
   ],
   "objects_affected": [
    "litter-box",
    "the-poopervisor"
   ],
   "epistemic": "DECIDED"
  },
  {
   "id": "mechanism_actuation_disabled",
   "rule": "Mechanism objects expose state; they are not actuated by automation until a safety case exists.",
   "objects_affected": [
    "litter-box",
    "the-poopervisor"
   ],
   "epistemic": "DECIDED"
  },
  {
   "id": "public_id_uniqueness",
   "rule": "Every public object_id is unique and stable, and uniqueness is never manufactured by inventing a physical distinction. Where HA's own name does not distinguish siblings, the record says so (`label_disambiguated: false`) and the index is positional.",
   "evidence": [
    "six imported Smart Bulbs, three bedroom bulbs and three study bulbs arrive from HA with the same name and no distinguishing index"
   ],
   "epistemic": "DECIDED"
  },
  {
   "id": "reachability_is_not_state",
   "rule": "An object that is not reporting has UNKNOWN physical state. Its last reported value is not its current value.",
   "epistemic": "DECIDED"
  }
 ],
