  "notes": {
    "ecology": "Recovered from exact uncompressed Library source; direct static HTML; packed transport removed.",
    "scope": "This manifest describes public release surfaces only. Private recovery/open-thread state is intentionally excluded.",
    "field_intake": "Recovered from prior public release; runtime blobs preserved, service-worker cache cleanup narrowed to its own cache family.",
    "sleeper": "Public experiment. Same canonical state is exposed as first-person coupled law field and plain obligation list; geometry is explicitly not external truth.",
    "scale_lens": "RC11.2 remains the stable public head. G2 identity/RETURN is unchanged; optional spatial-donor-1 is projection-only. External smoke run 1 exposed mobile importer overflow; targeted importer-wrap patch fixed it and representative traversal passes at 390px + 1280px.",
    "triangle_bench": "Nested Field / Proof experiment. EXPLOIT / EXPLORE / PROVE simplex compared against a plain two-control allocation; no showcase card.",
    "showcase_trace": "PASS: external Chromium representative-interaction smoke on all nine showcase cards at 390px + 1280px, 18/18. GitHub Actions run 35372320053. Rerun after public runtime changes.",
    "capability_map": "Root showcase now exposes a transfer-oriented reading of the same nine public cards. Transfer labels describe reusable mechanisms, not additional public artifacts or a claim that a monolithic agent already exists.",
    "routing": "Nine public showcase artifacts now expose accepts/transforms/emits/evidence contracts. agent-router.json may compose or skip stages and selects the smallest adequate route under permission, reversibility and evidence constraints.",
    "execution_boundary": "Showcase contracts are public semantic/reference interfaces only. Private personal traffic and credentials belong to private runtime adapters; no public showcase route is an implicit execution endpoint.",
    "router_bench": "Deterministic public workbench over the live capability contracts and adapter declarations. It simulates routing/permission/RETURN only; private execution remains outside the public surface.",
    "human_return": "Public stable rendezvous for a known human when normal communication fails. No credentials/private contact graph/live-status claim; private execution and handoff remain behind the public boundary.",
    "person_resource_policy": "Deny-by-default seven-gate policy contract: READ, REMEMBER, ACKNOWLEDGE, ANSWER, DRAFT, ACT and ESCALATE. Public files contain schema/synthetic example only; real person/resource refs and policies belong to the private runtime.",
    "policy_inheritance": "Deterministic broad-to-narrow policy composition: base -> person/resource in parallel -> channel. Restriction is automatic; widening requires user_explicit grant authority. Same-stage deny wins, allow sets intersect, deny sets union, ceilings choose the minimum, locks are inherited and cannot be widened.",
    "policy_selectors": "Canonical selector syntax for base/person/resource/channel policy matching: exact, anchored glob pattern, tag-set, and fallback. Specificity exact > pattern > tag > fallback orders traces and suppresses fallback only; all matching non-fallback policies still enter deny/lock/grant merge."
  },
  "capability_model": {
    "CAPTURE": {
      "job": "turn ambiguous incoming material into typed, reviewable objects",
      "later_transfer": [
        "messages",
        "forms",
        "human notes",
        "sensor/log events"
      ]
    },
    "PLAY": {
      "job": "expose compact control over cyclic, agent and constraint state",
      "later_transfer": [
        "human steering",
        "adaptive interfaces",
        "physical controls"
      ]
    },
    "REPRESENT": {
      "job": "change projection without losing stable identity, provenance or return path",
      "later_transfer": [
        "context views",
        "briefs",
        "study interfaces",
        "human-readable handoff"
      ]
    },
    "PLAN": {
      "job": "bind addressed state to time, queue, export and replay",
      "later_transfer": [
        "follow-up queues",
        "schedules",
        "commitments"
      ]
    },
    "PROVE": {
      "job": "test whether interfaces and transformations help, then leave evidence",
      "later_transfer": [
        "automation validation",
        "safe handoff",
        "release gates"
      ]
    }
  },
