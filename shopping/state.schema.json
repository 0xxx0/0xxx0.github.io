{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "field-shopping-state/v0.1",
  "title": "Shopping Field State",
  "type": "object",
  "required": [
    "schema",
    "items"
  ],
  "properties": {
    "schema": {
      "const": "field-shopping-state/v0.1"
    },
    "updated": {
      "type": [
        "string",
        "null"
      ]
    },
    "currency": {
      "const": "SGD"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "need": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "state": {
            "enum": [
              "NEED",
              "QUERY",
              "FOUND",
              "VERIFY",
              "WATCH",
              "DECIDE",
              "BOUGHT",
              "RECEIVED",
              "TESTED",
              "ADOPTED",
              "HOLD",
              "SKIP",
              "EXPIRED",
              "RETURNED",
              "REPAIR",
              "ABANDONED",
              "ARCHIVE"
            ]
          },
          "source_kind": {
            "enum": [
              "project_gap",
              "listing",
              "owned_claim",
              "receipt",
              "recommendation",
              "aesthetic_or_idea",
              "other"
            ]
          },
          "observed_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "projects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "interfaces": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "storage_home": {
            "type": [
              "string",
              "null"
            ]
          },
          "adoption_criterion": {
            "type": "string"
          },
          "next_action": {
            "type": "string"
          },
          "legacy_state": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": "string"
          },
          "gate": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            }
          },
          "cost": {
            "type": "object",
            "properties": {
              "item": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "discount": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "cn_freight": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "intl_freight": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "local_freight": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "gst": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "fx_friction": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "failure_cost": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "quantity": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              }
            }
          },
          "lane": {
            "enum": [
              "ESSENTIAL",
              "CAPABILITY",
              "EXPEDITION"
            ]
          }
        }
      }
    }
  }
}
