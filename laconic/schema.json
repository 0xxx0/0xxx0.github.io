{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/laconic/schema.json",
  "title": "Laconic / Iconic Bank",
  "type": "object",
  "required": ["schema","title","provenance_classes","voices","scenarios","lines"],
  "properties": {
    "schema": {"const":"laconic-iconic-bank/v0.1"},
    "title": {"type":"string"},
    "provenance_classes": {"type":"object"},
    "voices": {"type":"array","items":{"type":"object","required":["id","law","avoid"]}},
    "scenarios": {"type":"array","items":{"type":"object","required":["id","label","default_move"]}},
    "lines": {
      "type":"array",
      "items":{
        "type":"object",
        "required":["id","text","provenance","scenario","move","voice","tags","next"],
        "properties":{
          "id":{"type":"string","pattern":"^li:[a-z0-9:_-]+$"},
          "text":{"type":"string","minLength":1,"maxLength":280},
          "provenance":{"enum":["EXACT","RECONSTRUCTED","NEW"]},
          "source_ref":{"type":"string"},
          "scenario":{"type":"string"},
          "move":{"enum":["NO_ACTION","ACK","ANSWER","ASK_ONE","ROUTE","DRAFT","ACT","HANDOFF"]},
          "voice":{"type":"string"},
          "tags":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
          "next":{"type":"array","uniqueItems":true,"items":{"type":"string"}}
        },
        "additionalProperties":true
      }
    }
  },
  "additionalProperties":true
}