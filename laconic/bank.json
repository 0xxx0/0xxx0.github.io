    {"id":"decline","label":"DECLINE","default_move":"DRAFT"},
    {"id":"repair","label":"REPAIR","default_move":"DRAFT"},
    {"id":"gratitude","label":"GRATITUDE","default_move":"ACK"},
    {"id":"affection","label":"AFFECTION","default_move":"DRAFT"},
    {"id":"close","label":"CLOSE","default_move":"ACK"},
    {"id":"challenge","label":"CHALLENGE","default_move":"DRAFT"}
  ],
  "lines": [
