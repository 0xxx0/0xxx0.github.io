  "principle": "Anticipate recurring exchanges; compress without flattening; preserve provenance; select Pareto winners; grow winners into trajectories; never confuse drafting with permission to send.",
  "provenance_classes": {
    "EXACT": "Verbatim recovered source with a source reference.",
    "RECONSTRUCTED": "Faithful reconstruction where exact wording is unavailable.",
    "NEW": "New candidate created after recovery; never represented as historical."
  },
  "voices": [
    {"id":"CUT","law":"Remove everything that does not change the move.","avoid":"polite fog, throat-clearing, duplicate reassurance"},
    {"id":"GLINT","law":"One turn of wit or surprise; stop before performance.","avoid":"stacked jokes, cute filler"},
    {"id":"WARM","law":"Transmit contact without gush.","avoid":"generic affection, over-explaining care"},
    {"id":"ODD","law":"Use one memorable image or semantic tilt.","avoid":"random surrealism"},
    {"id":"GRAVITY","law":"Steady weight, plain consequence.","avoid":"theatrical severity"},
    {"id":"OPEN","law":"Leave a clean aperture for the next move.","avoid":"premature closure"}
  ],
  "scenarios": [
    {"id":"receipt","label":"RECEIPT","default_move":"ACK"},
    {"id":"accept","label":"ACCEPT","default_move":"ANSWER"},
