.orig .q{font-weight:700}
.list{display:grid;grid-template-columns:120px 1fr;gap:6px 14px;margin-top:14px;font-size:15px}
.list dt{font-weight:700;letter-spacing:.02em}
.list dd{margin:0;word-spacing:.1em}
.legend{display:flex;flex-wrap:wrap;gap:6px 20px;margin:16px 0 4px;font-size:13px;color:var(--mut)}
.legend b{color:var(--ink)}
.rows{border-top:1px solid var(--rule);margin-top:10px}
.row{display:grid;grid-template-columns:30px 224px 1fr 34px;gap:12px;padding:11px 0;border-bottom:1px solid var(--rule);align-items:start}
