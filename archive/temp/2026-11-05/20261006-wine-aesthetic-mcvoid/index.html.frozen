header{border-bottom:3px solid var(--ink);padding-bottom:14px}
h1{font:800 clamp(34px,9vw,64px)/0.94 system-ui,-apple-system,Segoe UI,sans-serif;letter-spacing:-.045em;margin:0 0 10px;text-transform:uppercase}
.sub{color:var(--mut);font-size:14px;margin-top:2px}
.meta{display:flex;flex-wrap:wrap;gap:6px 18px;margin-top:12px;font-size:11.5px;color:var(--mut);letter-spacing:.05em;text-transform:uppercase}
.meta b{color:var(--ink)}
h2{font:800 13px/1.2 system-ui,sans-serif;letter-spacing:.16em;text-transform:uppercase;margin:38px 0 10px;
 border-top:2px solid var(--ink);padding-top:12px}
h3{font:700 14px/1.25 system-ui,sans-serif;margin:20px 0 6px}
p{margin:9px 0}
.small{font-size:13px;color:var(--mut)}
