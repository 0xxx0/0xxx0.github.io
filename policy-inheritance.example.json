          ],
          "reason_code": "door.reversible"
        },
        {
          "op": "set_ceiling",
          "path": "/permissions/act/scope/max_actions_per_event",
          "value": 1,
          "reason_code": "door.one.action"
        }
      ],
      "locks": [],
      "notes_ref": null
    }
  ],
  "channel_overrides": [
    {
      "id": "channel:email-no-device-act",
      "layer": "channel",
      "mode": "restrict",
      "extends": [],
      "selector": {
        "channels": [
          "email"
        ],
        "resource_classes": [
          "device"
        ]
      },
      "authority": {
        "source": "operator_defined",
        "issued_at": "2026-09-18T17:18:00Z",
        "expires_at": null,
        "revision": 1,
        "authorization_ref": null
      },
      "operations": [
        {
          "op": "restrict_decision",
          "path": "/permissions/act/decision",
          "value": "deny",
          "reason_code": "email.device.deny"
        },
        {
          "op": "lock",
          "path": "/permissions/act/decision",
          "reason_code": "email.device.lock"
        }
      ],
      "locks": [
