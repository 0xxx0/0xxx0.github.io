          "resource:door-lock"
        ],
        "resource_classes": [
          "device"
        ]
      },
      "authority": {
        "source": "operator_defined",
        "issued_at": "2026-09-18T17:17:00Z",
        "expires_at": null,
        "revision": 1,
        "authorization_ref": null
      },
      "operations": [
        {
          "op": "restrict_decision",
          "path": "/permissions/act/decision",
          "value": "review",
          "reason_code": "door.act.review"
        },
