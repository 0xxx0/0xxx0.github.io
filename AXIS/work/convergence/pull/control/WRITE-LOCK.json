    },
    {
      "resource": "CURRENT.md",
      "owner_session_id": "<placeholder>",
      "acquired_at": "<placeholder_iso_8601_ts>",
      "expires_at": "<placeholder_iso_8601_ts>"
    }
  ],
  "policy": {
