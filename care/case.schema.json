{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://0xxx0.github.io/care/case.schema.json",
  "title": "CARE case v0.3 + additive evidence references",
  "type": "object",
  "required": [
    "schema",
    "id",
    "created_at",
    "updated_at",
    "subject",
    "events"
  ],
  "properties": {
    "schema": {
      "const": "0xxx0/care-case/v0.3"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "subject": {
      "type": "object",
      "required": [
        "label",
        "kind"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "PERSON",
            "ANIMAL"
          ]
        }
      },
      "additionalProperties": true
    },
    "baseline": {
      "type": "string"
    },
    "treatment": {
      "type": "string"
    },
    "plan": {
      "type": "string"
    },
    "plan_source": {
      "type": "string"
    },
    "ask": {
      "type": "string"
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "identity_note": {
      "type": "string"
    },
    "course": {
      "type": "object",
      "properties": {
        "phase": {
          "type": "string"
        },
        "next": {
          "type": "string"
        },
        "gate": {
          "type": "string"
        },
        "gate_source": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "due": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "at",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "at": {
            "type": "string"
          },
          "type": {
            "enum": [
              "OBSERVATION",
              "MEASUREMENT",
              "TREATMENT",
              "APPOINTMENT",
              "RESULT"
            ]
          },
          "status": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "PLANNED",
              "SCHEDULED",
              "PERFORMED",
              "RESULTED",
              "REVIEWED",
              "ACTED",
              null
            ]
          },
          "raw_note": {
            "type": "string"
          },
          "regions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "trace": {
            "type": "array"
          },
          "qualities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "magnitude": {
            "type": [
              "number",
              "null"
            ]
          },
          "trend": {
            "enum": [
              "NEW",
              "WORSE",
              "SAME",
              "BETTER"
            ]
          },
          "evidence_kind": {
            "type": "string"
          },
          "measurement": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "value"
                ],
                "properties": {
                  "label": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "value": {
                    "type": [
                      "string",
                      "number"
                    ]
                  },
                  "unit": {
                    "type": "string"
                  }
                },
                "additionalProperties": true
              }
            ]
          },
          "interpretation": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_cue": {
            "type": [
              "string",
              "null"
            ]
          },
          "prior_same_region_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "bodyfield_geometry": {
            "type": [
              "object",
              "null"
            ]
          },
          "bodyfield_dimensions": {
            "type": [
              "object",
              "null"
            ]
          },
          "body_map": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "schema",
                  "plan_id",
                  "view",
                  "region_ids",
                  "region_labels"
                ],
                "properties": {
                  "schema": {
                    "const": "0xxx0/body-address/v0.1"
                  },
                  "plan_id": {
                    "type": "string"
                  },
                  "view": {
                    "type": "string"
                  },
                  "view_box": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "region_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "region_labels": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "geometry_version": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "trace_space": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "additionalProperties": true
              }
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "imports": {
      "type": "array"
    },
    "body_plan": {
      "type": "string",
      "description": "Reference body-plan ID used for current capture surface; does not assert personal anatomy."
    },
    "evidence_refs": {
      "type": "array",
      "description": "References to HUMAN PORT objects attached explicitly to the case. Source bytes remain governed by Port retention; CARE stores identity/provenance/focus, not duplicate file bytes.",
      "items": {
        "type": "object",
        "required": [
          "schema",
          "id",
          "attached_at",
          "port_object_id",
          "label",
          "media_class",
          "availability"
        ],
        "properties": {
          "schema": {
            "const": "0xxx0/care-evidence-ref/v0.1"
          },
          "id": {
            "type": "string"
          },
          "attached_at": {
            "type": "string"
          },
          "port_object_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "media_class": {
            "enum": [
              "TEXT",
              "JSON",
              "IMAGE",
              "FILE"
            ]
          },
          "mime": {
            "type": [
              "string",
              "null"
            ]
          },
          "size_bytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "retention": {
            "type": "string"
          },
          "provenance": {
            "type": "object"
          },
          "scope": {
            "enum": [
              "whole",
              "focus"
            ]
          },
          "focus": {
            "type": [
              "object",
              "null"
            ]
          },
          "projection_excerpt": {
            "type": [
              "string",
              "null"
            ]
          },
          "port_payload_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "availability": {
            "enum": [
              "PORT_LOCAL_STASH",
              "SESSION_OR_REFERENCE_ONLY"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
